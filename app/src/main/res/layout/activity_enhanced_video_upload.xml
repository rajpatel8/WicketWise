<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/cricket_green_primary"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/white"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upload Video for Feedback"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="56dp" />

        </LinearLayout>

        <!-- Video Selection Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Video"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Video Selection Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/selectVideoBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Choose from Gallery"
                        android:textColor="@color/cricket_green_primary"
                        android:strokeColor="@color/cricket_green_primary"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/recordVideoBtn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Record New"
                        android:backgroundTint="@color/cricket_green_primary"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <!-- Video Preview -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="@color/background_secondary">

                    <VideoView
                        android:id="@+id/videoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/thumbnailPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📹\nSelect or record a video"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />

                </FrameLayout>

                <!-- Video Info -->
                <TextView
                    android:id="@+id/videoInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Video Details Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Video Details"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <!-- Title Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/videoTitleLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="@color/cricket_green_primary"
                    app:hintTextColor="@color/cricket_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/videoTitleEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Video Title"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/videoDescriptionLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="@color/cricket_green_primary"
                    app:hintTextColor="@color/cricket_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/videoDescriptionEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Description (Optional)"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:maxLines="5" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Coach Selection Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Coaches for Feedback"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose which coaches you want feedback from"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="16dp" />

                <!-- No Coaches Message -->
                <TextView
                    android:id="@+id/noCoachesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ No coaches available\nPlease get accepted by coaches first"
                    android:textAlignment="center"
                    android:textColor="@color/warning_color"
                    android:textSize="14sp"
                    android:padding="16dp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="@color/warning_background"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- Coach Selection Button -->
                <Button
                    android:id="@+id/selectCoachesBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Coaches"
                    android:textColor="@color/cricket_green_primary"
                    android:strokeColor="@color/cricket_green_primary"
                    android:drawableStart="@drawable/ic_coach"
                    android:drawableTint="@color/cricket_green_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Selected Coaches Display -->
                <TextView
                    android:id="@+id/selectedCoachesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No coaches selected"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="@color/background_secondary"
                    android:padding="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Upload Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Upload Status -->
                <TextView
                    android:id="@+id/uploadStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Uploading video..."
                    android:textAlignment="center"
                    android:textColor="@color/cricket_green_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="@color/success_background"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- Upload Button -->
                <Button
                    android:id="@+id/uploadVideoBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Video for Feedback"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/cricket_green_primary"
                    android:drawableStart="@drawable/ic_upload"
                    android:drawableTint="@color/white"
                    android:padding="16dp"
                    android:visibility="gone" />

                <!-- Upload Instructions -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📝 Instructions:\n• Select a video from gallery or record new\n• Add a descriptive title\n• Choose coaches for feedback\n• Upload and wait for coach responses"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
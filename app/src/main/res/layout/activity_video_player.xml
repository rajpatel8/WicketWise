<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header with title and student info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cricket_green_dark"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/studentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:alpha="0.8" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Save"
            android:textColor="@color/white"
            android:background="@drawable/btn_white_rounded"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Main video container with annotation overlay -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/black">

        <!-- Video View -->
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Annotation Overlay - MUST be after VideoView to be on top -->
        <com.lords.becomebetter.AnnotationOverlay
            android:id="@+id/annotationOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- Cricket Tools Panel (Side) - OPTIMIZED sizing -->
        <LinearLayout
            android:id="@+id/cricketToolsPanel"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/tools_panel_background_improved"
            android:padding="4dp"
            android:elevation="8dp">

            <!-- Field Layout Tool -->
            <ImageButton
                android:id="@+id/fieldLayoutTool"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/annotation_tool_selector"
                android:src="@drawable/ic_grid_view"
                android:contentDescription="Field Layout"
                android:scaleType="centerInside"
                android:padding="8dp"
                app:tint="@color/white" />

            <!-- Player Marker Tool -->
            <ImageButton
                android:id="@+id/playerMarkerTool"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/annotation_tool_selector"
                android:src="@drawable/ic_person_pin"
                android:contentDescription="Player Markers"
                android:scaleType="centerInside"
                android:padding="8dp"
                app:tint="@color/white" />

            <!-- Ball Path Tool -->
            <ImageButton
                android:id="@+id/ballPathTool"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/annotation_tool_selector"
                android:src="@drawable/ic_timeline"
                android:contentDescription="Ball Path"
                android:scaleType="centerInside"
                android:padding="8dp"
                app:tint="@color/white" />

            <!-- Notes Tool -->
            <ImageButton
                android:id="@+id/notesTool"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/annotation_tool_selector"
                android:src="@drawable/ic_note_add"
                android:contentDescription="Notes"
                android:scaleType="centerInside"
                android:padding="8dp"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Instruction Text - IMPROVED positioning -->
<!--        <TextView-->
<!--            android:id="@+id/instructionText"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="💡 Tap and draw on the video to add annotations"-->
<!--            android:textColor="@color/white"-->
<!--            android:textSize="13sp"-->
<!--            android:background="@drawable/instruction_background_improved"-->
<!--            android:padding="12dp"-->
<!--            android:layout_gravity="bottom|center_horizontal"-->
<!--            android:layout_marginBottom="140dp"-->
<!--            android:alpha="0.9"-->
<!--            android:drawablePadding="8dp" />-->

    </FrameLayout>

    <!-- ========================================== -->
    <!-- FIXED: SCROLLABLE Drawing Tools Panel -->
    <!-- ========================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cricket_green_dark"
        android:orientation="vertical"
        android:elevation="4dp">

        <!-- Tool Category Label (Optional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drawing Tools"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:alpha="0.7"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- HORIZONTAL SCROLL VIEW for drawing tools -->
        <HorizontalScrollView
            android:id="@+id/drawingToolsScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fadeScrollbars="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:id="@+id/drawingToolsPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Pen Tool -->
                <ImageButton
                    android:id="@+id/penTool"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="Pen"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- Highlighter Tool -->
                <ImageButton
                    android:id="@+id/highlighterTool"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_highlight"
                    android:contentDescription="Highlighter"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- Arrow Tool -->
                <ImageButton
                    android:id="@+id/arrowTool"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_arrow_forward"
                    android:contentDescription="Arrow"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- Circle Tool -->
                <ImageButton
                    android:id="@+id/circleTool"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_circle"
                    android:contentDescription="Circle"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- Rectangle Tool -->
                <ImageButton
                    android:id="@+id/rectangleTool"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_rectangle"
                    android:contentDescription="Rectangle"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- Color Picker -->
                <ImageButton
                    android:id="@+id/colorPicker"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_palette"
                    android:contentDescription="Color"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- SEPARATOR LINE -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="32dp"
                    android:background="@color/white"
                    android:alpha="0.3"
                    android:layout_marginHorizontal="8dp" />

                <!-- Undo Button -->
                <ImageButton
                    android:id="@+id/undoButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_undo"
                    android:contentDescription="Undo"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- Redo Button -->
                <ImageButton
                    android:id="@+id/redoButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_redo"
                    android:contentDescription="Redo"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

                <!-- Clear Button -->
                <ImageButton
                    android:id="@+id/clearButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/annotation_tool_selector"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="Clear All"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@color/white" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Scroll Indicator (Optional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Swipe to see more tools →"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:alpha="0.6"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

    <!-- Video Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cricket_green_dark"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Seek Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/timeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00 / 00:00"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/cricket_green_primary"
                android:thumbTint="@color/cricket_green_primary" />

        </LinearLayout>

        <!-- Video Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Rewind 10s Button -->
            <ImageButton
                android:id="@+id/backwardButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/video_control_button"
                android:src="@drawable/ic_replay_10"
                android:contentDescription="Rewind 10s"
                app:tint="@color/white" />

            <!-- Frame Backward Button -->
            <ImageButton
                android:id="@+id/frameBackwardButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/video_control_button"
                android:src="@drawable/ic_skip_previous"
                android:contentDescription="Previous Frame"
                app:tint="@color/cricket_green_primary" />

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/video_control_button_large"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Play/Pause"
                app:tint="@color/white" />

            <!-- Frame Forward Button -->
            <ImageButton
                android:id="@+id/frameForwardButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/video_control_button"
                android:src="@drawable/ic_skip_next"
                android:contentDescription="Next Frame"
                app:tint="@color/cricket_green_primary" />

            <!-- Forward 10s Button -->
            <ImageButton
                android:id="@+id/forwardButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/video_control_button"
                android:src="@drawable/ic_forward_10"
                android:contentDescription="Forward 10s"
                app:tint="@color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
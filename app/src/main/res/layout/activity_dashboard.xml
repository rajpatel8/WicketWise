<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_primary"
    tools:context=".DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section with Brand Gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/login_gradient_background"
            android:paddingBottom="32dp">

            <!-- Top Bar with Logout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/welcomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back!"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready to become better?"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:alpha="0.9"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Logout"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="20dp"
                    android:paddingHorizontal="20dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <!-- User Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical">

                    <!-- Profile Avatar -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/logo_circle_background"
                        android:backgroundTint="@color/brand_light">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_person"
                            android:layout_gravity="center"
                            app:tint="@color/brand_primary" />

                    </FrameLayout>

                    <!-- User Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/userNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User Name"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/status_badge_background"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_sports_cricket"
                                app:tint="@color/brand_primary"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/userTypeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Coach/Student"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Status Indicator -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="40dp"
                        android:background="@drawable/rounded_background"
                        android:backgroundTint="@color/brand_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginTop="-16dp">

            <!-- Quick Actions Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quick Actions"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/brand_primary" />

            </LinearLayout>

            <!-- Common Action Buttons (always visible) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="0dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/viewProfileBtn"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:text="View Profile"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_primary"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_person"
                        app:iconTint="@color/white"
                        app:iconGravity="top"
                        app:iconPadding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="0dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editProfileBtn"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:text="Edit Profile"
                        android:textColor="@color/brand_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_light"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_person"
                        app:iconTint="@color/brand_primary"
                        app:iconGravity="top"
                        app:iconPadding="8dp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Coach Actions Section -->
            <LinearLayout
                android:id="@+id/coachActionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="0dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/viewStudentsBtn"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:text="My Students"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_secondary"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_student"
                        app:iconTint="@color/white"
                        app:iconGravity="top"
                        app:iconPadding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="0dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manageSessionsBtn"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:text="Requests"
                        android:textColor="@color/brand_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_light"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_video_camera"
                        app:iconTint="@color/brand_secondary"
                        app:iconGravity="top"
                        app:iconPadding="8dp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Student Actions Section -->
            <LinearLayout
                android:id="@+id/studentActionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Row 1: Upload Video and View Feedback -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/card_background"
                        app:strokeWidth="0dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/uploadVideoBtn"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:text="Upload Video"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/brand_primary"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_upload"
                            app:iconTint="@color/white"
                            app:iconGravity="top"
                            app:iconPadding="8dp" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/card_background"
                        app:strokeWidth="0dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/viewFeedbackBtn"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:text="View Feedback"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/brand_secondary"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_feedback"
                            app:iconTint="@color/white"
                            app:iconGravity="top"
                            app:iconPadding="8dp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Row 2: Find Coach and My Requests -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/card_background"
                        app:strokeWidth="0dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/findCoachBtn"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:text="Find Coach"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/success"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_search"
                            app:iconTint="@color/white"
                            app:iconGravity="top"
                            app:iconPadding="8dp" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/card_background"
                        app:strokeWidth="0dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bookSessionBtn"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:text="My Requests"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/warning"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_calendar"
                            app:iconTint="@color/white"
                            app:iconGravity="top"
                            app:iconPadding="8dp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Stats Section (Optional) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/feedbackCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAlignment="center"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Feedback"
                            android:textAlignment="center"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/uploadsCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAlignment="center"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Videos"
                            android:textAlignment="center"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
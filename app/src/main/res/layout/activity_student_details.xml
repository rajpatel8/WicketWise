<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="12dp"
            app:tint="@color/cricket_green_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Student Details"
            android:textSize="20sp"
            android:textColor="@color/cricket_green_primary"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Student Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/white"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Student Avatar -->
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_person"
                        android:background="@android:drawable/btn_default"
                        android:backgroundTint="@color/cricket_green_light"
                        android:padding="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp" />

                    <!-- Student Name -->
                    <TextView
                        android:id="@+id/studentNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Student Name"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <!-- Student Email -->
                    <TextView
                        android:id="@+id/studentEmailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="student@email.com"
                        android:textSize="16sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginBottom="20dp" />

                    <!-- Student Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/studentAgeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Age: 16"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:padding="8dp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/studentSkillText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Skill Level: Intermediate"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:padding="8dp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/studentPhoneText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Phone: +1234567890"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:padding="8dp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/joinDateText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Joined: 2024-06-24"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:padding="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/viewVideosBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Student Videos"
                    android:backgroundTint="@color/cricket_green_primary"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/sendMessageBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send Message"
                    android:textColor="@color/cricket_green_primary"
                    android:background="?android:attr/selectableItemBackground"
                    android:textSize="16sp"
                    android:padding="16dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>